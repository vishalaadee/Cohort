# ---- copy to .env and change every secret before deploying ----

# ===== Local/dev only (docker-compose.yml) — ignored when using RDS =====
POSTGRES_DB=placement
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=change-this-super-pw

# ===== RDS (docker-compose.aws.yml + scripts/apply-schema-rds.sh) =====
# RDS_ADMIN_USER is only ever used interactively by apply-schema-rds.sh —
# its password is prompted for at run time and is never stored here.
RDS_HOST=your-db-instance.xxxxxxxxxx.ap-south-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB=placement
RDS_ADMIN_USER=postgres

# the non-superuser role the API uses so Row-Level Security is enforced
APP_DB_USER=app_user
APP_DB_PASSWORD=change-this-app-pw

# read-only role for the Prometheus postgres-exporter (pg_monitor only —
# cannot read a single row of student/company data)
MONITOR_DB_USER=monitor
MONITOR_DB_PASSWORD=change-this-monitor-pw

JWT_SECRET=change-this-to-a-long-random-string
JWT_ALG=HS256

# "Sign in with Google" — OAuth client ID from Google Cloud Console
# (see OPERATIONS_GUIDE.md §1). Leave empty to hide the Google button and
# use password + activation-code onboarding only.
GOOGLE_CLIENT_ID=

# true = unauthenticated requests act as the demo admin (LOCAL DEMOS ONLY)
DEV_FALLBACK=false

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-pw

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-pw

# your domain; use ":80" locally for http without TLS
SITE_ADDRESS=:80
